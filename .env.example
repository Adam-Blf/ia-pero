# L'IA Pero - Environment Configuration
# Copy this file to .env and fill in the keys you want to enable.
# The app boots and works in fallback mode without any key.

# ── Google Gemini API (optional) ─────────────────────────────────────────────
# Enables full AI recipe generation. Without this key the app falls back to
# pre-defined local recipes (more generic, but fully functional).
# Get your free key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# ── Kaggle Dataset Enrichment (optional) ─────────────────────────────────────
# Enables downloading the ~1 600 extra cocktails from Kaggle.
# Without these, the app uses the 600 pre-generated cocktails (data/cocktails.csv).
# Get your credentials at: https://www.kaggle.com/settings/account → API → Create Token
# Then either:
#   a) Place ~/.kaggle/kaggle.json (standard Kaggle CLI setup), OR
#   b) Set the two variables below:
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key
